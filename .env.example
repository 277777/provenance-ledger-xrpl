PORT=3000
XRPL_MODE=mock
XRPL_ENDPOINT=wss://s.devnet.rippletest.net:51233

# Demo API access. Replace these for any shared deployment.
AUTHORITY_ACCESS_KEY=authority-demo-key
AURORA_ACCESS_KEY=aurora-ai-demo-key
NORTHSTAR_ACCESS_KEY=northstar-ai-demo-key
EDITOR_ACCESS_KEY=studio-editor-demo-key
CAMERA_ACCESS_KEY=capture-device-demo-key
OPEN_CLAIMS_ACCESS_KEY=open-claims-demo-key

# Optional XRPL Devnet seeds. If omitted in Devnet mode, the faucet creates
# temporary wallets in memory. Never commit real seeds.
# REGISTRY_XRPL_SEED=s...
# AUTHORITY_XRPL_SEED=s...
# AURORA_AI_XRPL_SEED=s...
# NORTHSTAR_AI_XRPL_SEED=s...
# EDITOR_XRPL_SEED=s...
# CAMERA_XRPL_SEED=s...
# OPEN_CLAIMS_XRPL_SEED=s...
